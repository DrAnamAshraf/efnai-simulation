{
  "description": "EFNAI technical-verification simulation, version 2 (re-implemented). Values marked 'assumption' are the author's illustrative choices and are NOT taken from the literature.",
  "random_seed": 42,
  "dataset": {
    "n_subjects": 973, "n_adhd": 491, "n_controls": 482, "n_sites": 8, "n_ROIs": 116,
    "parcellation": "AAL-116",
    "source": "Site sizes after Bellec et al. (2017); per-site ADHD counts as in the earlier manuscript version"
  },
  "sites": [
    {"name": "NYU",        "n": 172, "n_adhd": 86},
    {"name": "Peking",     "n": 193, "n_adhd": 97},
    {"name": "OHSU",       "n": 79,  "n_adhd": 40},
    {"name": "KKI",        "n": 83,  "n_adhd": 42},
    {"name": "NI",         "n": 79,  "n_adhd": 40},
    {"name": "Pittsburgh", "n": 100, "n_adhd": 50},
    {"name": "WashU",      "n": 134, "n_adhd": 67},
    {"name": "Brown",      "n": 133, "n_adhd": 69}
  ],
  "generative_model": {
    "baseline_fc": {"within_DMN": 0.30, "within_FPN": 0.25, "within_SAL": 0.30,
                    "DMN_FPN": 0.10, "AMY_vmPFC": 0.10, "CER_FPN": 0.05, "background": 0.12,
                    "note": "assumption: illustrative template values, not fitted to data"},
    "between_subject_sd_of_block_mean_tau": 0.05,
    "edge_noise_sd": 0.12,
    "global_shift_sd": 0.03,
    "site_offset_sd_in_tau_units": {"base": 0.5, "increment_per_site": 0.1,
                    "note": "assumption: site offset SD = (base + increment*site_index) * tau, per block"},
    "adhd_effect_cohen_d": {
      "DMN_within": 0.42,
      "DMN_range_cited": [0.32, 0.48],
      "DMN_source": "value and range as stated in the earlier manuscript (Zhao et al., 2022; Wang et al., 2023; Firouzi et al., 2024); to be re-checked against those papers",
      "FPN_within": 0.30, "DMN_FPN": 0.30, "SAL_within": 0.15, "AMY_vmPFC": 0.0, "CER_FPN": 0.20,
      "note": "all non-DMN values are assumptions, not literature estimates; amygdala-vmPFC is set to zero because no direction is assumed"
    }
  },
  "classifiers": {
    "GB":  {"n_estimators": 150, "max_depth": 3, "learning_rate": 0.10, "subsample": 0.8, "min_samples_leaf": 10},
    "LR":  {"C": 0.3},
    "SVM": {"kernel": "rbf", "C": 0.8},
    "RF":  {"n_estimators": 100, "max_depth": 6, "min_samples_leaf": 8}
  },
  "evaluation": {"cv_folds": 10, "bootstrap_replications": 1000, "bootstrap_ci": 0.95,
                 "federated": "leave-one-site-out, no differential privacy"},
  "known_answer_checks": {"oracle_sample_size": 10000, "effect_scales": [0.0, 0.5, 1.0, 1.5, 2.0],
                          "replicates_per_scale": 5, "label_permutations": 100},
  "dp": {"n_sites": 3, "n_local": 50, "rounds": 100, "local_epochs": 5, "batch_size": 32,
         "clip_norm": 1.0, "delta": 1e-5, "learning_rate": 0.1, "replicates": 30,
         "sigmas": [1.1, 2, 3, 5, 7.5, 10, 18.1, 30, 50, 75.5],
         "pool_size": 6000, "test_size": 1000}
}
