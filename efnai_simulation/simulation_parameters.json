{
  "description": "EFNAI simulation parameters with literature sources",
  "random_seed": 42,
  "dataset": {
    "n_subjects": 973,
    "n_adhd": 491,
    "n_controls": 482,
    "n_sites": 8,
    "n_ROIs": 116,
    "parcellation": "AAL-116",
    "source": "Bellec et al. (2017) NeuroImage 144:275-286"
  },
  "sites": [
    {"name": "NYU",        "n": 172},
    {"name": "Peking",     "n": 193},
    {"name": "OHSU",       "n": 79},
    {"name": "KKI",        "n": 83},
    {"name": "NI",         "n": 79},
    {"name": "Pittsburgh", "n": 100},
    {"name": "WashU",      "n": 134},
    {"name": "Brown",      "n": 133}
  ],
  "effect_sizes": {
    "DMN_hypoconnectivity_cohen_d": 0.42,
    "DMN_range": [0.32, 0.48],
    "DMN_source": "Zhao et al. (2022); Firouzi et al. (2024); Wang M. et al. (2023)",
    "DMN_ROIs": "67-90 (AAL-116)",
    "FPN_ROIs": "1-20 (AAL-116)",
    "SAL_ROIs": "21-40 (AAL-116)",
    "Amy_ROIs": "41-42 (AAL-116)",
    "Cereb_ROIs": "91-116 (AAL-116)"
  },
  "noise": {
    "base_sigma": 1.8,
    "site_bias_scale": 0.05,
    "site_bias_increment": 0.008
  },
  "classifier": {
    "GFC": {
      "type": "GradientBoostingClassifier",
      "n_estimators": 150,
      "max_depth": 3,
      "learning_rate": 0.10,
      "subsample": 0.8,
      "min_samples_leaf": 10,
      "random_state": 42
    },
    "LR": {"type": "LogisticRegression", "C": 0.3},
    "SVM": {"type": "SVC", "kernel": "rbf", "C": 0.8, "probability": true},
    "RF": {"type": "RandomForestClassifier", "n_estimators": 100, "max_depth": 6, "min_samples_leaf": 8}
  },
  "evaluation": {
    "cv_folds": 10,
    "cv_strategy": "StratifiedKFold",
    "bootstrap_replications": 300,
    "bootstrap_ci": 0.95,
    "federated_evaluation": "site-held-out (leave-one-site-out)",
    "dp_applied_federated": false,
    "note": "No DP applied to federated evaluation — upper bound only"
  }
}
